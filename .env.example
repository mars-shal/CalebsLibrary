# Convex — client-safe values only.
# Copy to .env and fill in. Secret keys (deploy key, admin passphrase, Upstash
# token) never belong here — set those via `npx convex env set` so they only
# live server-side.
VITE_CONVEX_URL=https://your-project-name-0000.convex.cloud

# Public Sentry browser DSN. Client-safe: it is a write-only ingest key, and the
# browser SDK is designed to ship it. No auth or API token lives in it.
VITE_SENTRY_DSN=

# Session Replay is a paid Sentry feature. Set to "false" to drop the replay
# payload if the project does not have it enabled.
VITE_SENTRY_REPLAY=true
